<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Airbnb</title>

    <link href="/output.css" rel="stylesheet" />
  </head>

  <body
    class="min-h-screen bg-gradient-to-br from-pink-100 via-purple-100 to-blue-100"
  >
    <!-- Header -->
    <header
      class="bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 shadow-lg"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
      >
        <h1 class="text-3xl font-extrabold text-white">🏡 Airbnb</h1>

        <span
          class="rounded-full bg-white/20 px-4 py-2 text-sm font-semibold text-white backdrop-blur"
        >
          Find your perfect stay ✨
        </span>
      </div>
    </header>

    <!-- Main -->
    <main
      class="mx-auto flex min-h-[85vh] max-w-6xl items-center justify-center px-6 py-12"
    >
      <!-- House Card -->
      <div
        class="w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl transition duration-300 hover:-translate-y-2 hover:shadow-pink-300/50"
      >
        <!-- Colorful Image Area -->
        <div
          class="relative flex h-72 items-center justify-center overflow-hidden bg-gradient-to-br from-orange-400 via-pink-500 to-purple-600"
        >
          <div
            class="absolute -left-10 -top-10 h-40 w-40 rounded-full bg-yellow-300/40 blur-2xl"
          ></div>
          <div
            class="absolute -bottom-10 -right-10 h-52 w-52 rounded-full bg-blue-400/40 blur-2xl"
          ></div>

          <div class="relative text-center text-white">
            <div class="text-8xl drop-shadow-lg">🏠</div>
            <p class="mt-3 text-lg font-bold">Your beautiful stay awaits!</p>
          </div>

          <!-- Rating -->
          <div
            class="absolute right-5 top-5 flex items-center gap-1 rounded-full bg-white px-4 py-2 font-bold text-gray-800 shadow-lg"
          >
            <span class="text-yellow-500">★</span>
            <%= home.rating %>
          </div>
        </div>

        <!-- Details -->
        <div class="p-8">
          <!-- Category -->
          <p
            class="mb-2 text-sm font-bold uppercase tracking-widest text-pink-500"
          >
            ✨ Entire Home
          </p>

          <!-- House Name -->
          <h2 class="text-4xl font-extrabold text-gray-900">
            <%= home.housename %>
          </h2>

          <!-- Location -->
          <div class="mt-4 flex items-center gap-2 text-lg text-gray-600">
            <span class="rounded-full bg-pink-100 p-2">📍</span>
            <span><%= home.location %></span>
          </div>

          <!-- Features -->
          <div class="mt-6 grid grid-cols-3 gap-3">
            <div class="rounded-2xl bg-pink-50 p-4 text-center">
              <div class="text-2xl">🛏️</div>
              <p class="mt-1 text-sm font-semibold text-pink-700">
                Comfortable
              </p>
            </div>

            <div class="rounded-2xl bg-purple-50 p-4 text-center">
              <div class="text-2xl">✨</div>
              <p class="mt-1 text-sm font-semibold text-purple-700">Premium</p>
            </div>

            <div class="rounded-2xl bg-blue-50 p-4 text-center">
              <div class="text-2xl">📶</div>
              <p class="mt-1 text-sm font-semibold text-blue-700">Wi-Fi</p>
            </div>
          </div>

          <!-- Divider -->
          <div class="my-7 border-t border-gray-200"></div>

          <!-- Price + Button -->
          <div
            class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <p class="text-sm font-medium text-gray-500">Price per night</p>

              <p class="mt-1 text-4xl font-extrabold text-gray-900">
                $<%= home.price %>
                <span class="text-base font-medium text-gray-500">
                  / night
                </span>
              </p>
            </div>

            <button
              class="rounded-2xl bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 px-8 py-4 font-bold text-white shadow-lg transition duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
            >
              Reserve Now 🚀
            </button>
            <form action="/favorities">
              <button
                class="rounded-2xl bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 px-8 py-4 font-bold text-white shadow-lg transition duration-300 hover:scale-105 hover:shadow-xl active:scale-95"
              >
                Add to Favorites ❤️
              </button>
              <input type="hidden" name="homeId" value="<%= home.id %>" />
            </form>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
```
