<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title> <link href="/output.css" rel="stylesheet" />
  </head>
  <body>
    <h1 class="text-blue-800 text-3xl font-bold text-center my-6 underline">Add Home</h1>
    <form action="/host/add-home" method="POST" class="max-w-md mx-auto shadow-lg p-6 rounded-lg space-y-4 border-4 border-yellow-400 bg-gradient-to-br from-pink-400 via-yellow-200 to-blue-300">
      <div>
        <label for="name" class="block font-semibold text-gray-700 mb-1">Home Name:</label>
        <input
          type="text"
          id="name"
          name="housename"
          required
          class="w-full px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>
      <div>
        <label for="price" class="block font-semibold text-gray-700 mb-1">Price per night:</label>
        <input
          type="number"
          id="price"
          name="price"
          required
          placeholder="Price per night"
          min="1"
          class="w-full px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>
      <div>
        <label for="location" class="block font-semibold text-gray-700 mb-1">Location of the home:</label>
        <input
          type="text"
          id="location"
          name="location"
          required
          class="w-full px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>
      <div>
        <label for="rating" class="block font-semibold text-gray-700 mb-1">Rating</label>
        <input
          type="number"
          id="rating"
          name="rating"
          min="0"
          max="5"
          step="0.1"
          placeholder="Enter rating (0-5)"
          required
          class="w-full px-3 py-2 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>
      <div class="flex justify-center">
        <input
          type="submit"
          value="Add Home"
          class="bg-sky-500 text-white font-semibold px-6 py-2 rounded shadow hover:bg-sky-600 transition-colors cursor-pointer"
        />
      </div>
    </form>
  </body>
</html>
