```html
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="min-h-screen bg-slate-950 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <!-- Heading -->
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-white">Welcome Back 👋</h1>

        <p class="text-slate-400 mt-2">Login to your account</p>
      </div>

      <!-- Login Card -->
      <div
        class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl"
      >
        <form action="/login" method="POST" class="space-y-6">
          <!-- Email -->
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-slate-300 mb-2"
            >
              Email
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="Enter your email"
              required
              class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-500 outline-none transition duration-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 hover:border-slate-600"
            />
          </div>

          <!-- Password -->
          <div>
            <label
              for="password"
              class="block text-sm font-medium text-slate-300 mb-2"
            >
              Password
            </label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              required
              class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-500 outline-none transition duration-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 hover:border-slate-600"
            />
          </div>

          <!-- Remember / Forgot -->
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 text-sm text-slate-400">
              <input
                type="checkbox"
                class="w-4 h-4 rounded accent-indigo-600"
              />
              Remember me
            </label>

            <a
              href="#"
              class="text-sm text-indigo-400 hover:text-indigo-300 transition"
            >
              Forgot password?
            </a>
          </div>

          <!-- Login Button -->
          <button
            type="submit"
            class="w-full py-3 rounded-xl bg-indigo-600 text-white font-semibold transition duration-200 hover:bg-indigo-500 hover:shadow-lg hover:shadow-indigo-500/20 active:scale-[0.98]"
          >
            Login
          </button>
        </form>

        <!-- Register -->
        <p class="text-center text-sm text-slate-400 mt-6">
          Don't have an account?

          <a
            href="/auth/register"
            class="text-indigo-400 font-semibold hover:text-indigo-300 transition"
          >
            Create account
          </a>
        </p>
      </div>

      <!-- Footer -->
      <p class="text-center text-xs text-slate-600 mt-6">Secure login • 2026</p>
    </div>
  </body>
</html>
```
